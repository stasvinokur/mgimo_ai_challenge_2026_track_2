{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build src/ui/shell/pwa.config.mjs",
    "start": "node infra/standalone-start.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "depcruise": "depcruise --config dependency-cruiser.config.cjs src",
    "test": "vitest run",
    "spike:assistant": "node scripts/spikes/assistant/run.js",
    "test:e2e": "playwright test",
    "test:e2e:base-path": "playwright test --config tests/e2e/base-path.config.ts",
    "gallery": "playwright test --config tests/e2e/gallery.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test && pnpm build",
    "prepare:hooks": "lefthook install",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "demo:refresh": "tsx scripts/demo-refresh.ts",
    "docker:up": "docker compose up --build --wait",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait db",
    "pwa:icons": "node scripts/pwa-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@ai-sdk/react": "^4.0.166",
    "@fontsource/golos-text": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@serwist/next": "^9.5.13",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^7.0.162",
    "ai-sdk-ollama": "^4.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@serwist/cli": "^9.5.13",
    "@swc/core": "^1.16.21",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  }
}
