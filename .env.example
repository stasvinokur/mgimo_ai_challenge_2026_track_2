# Обязательно: PostgreSQL, в compose хост db, порт 5432, пользователь и БД pulse.
# Пароль внутри URL должен совпадать с POSTGRES_PASSWORD и быть URL-кодирован.
DATABASE_URL=
POSTGRES_PASSWORD=
# Только сервер: домен без протокола; DNS должен указывать на VPS.
APP_DOMAIN=
# Обязательно: внешний origin приложения, локальный HTTP или серверный HTTPS.
APP_ORIGIN=
# Папка при сборке: пусто — корень; на стенде /dekanat. Один сегмент, без слэша в конце.
# Смена требует пересборки app. APP_ORIGIN остаётся без пути.
BASE_PATH=
# Обязательно: тег собираемых образов. COMPOSE_FILE выбирает локальный/серверный набор.
IMAGE_TAG=
# Репозиторий образов: пустое значение — pulse для локальной сборки.
# В CI и на сервере: ghcr.io/trade-stasvinokur/mgimo-pulse (нижний регистр).
IMAGE_REPO=
COMPOSE_FILE=
# Пока необязательно: LLM и календарь будут подключены отдельными задачами.
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODEL=
ASSISTANT_RUNTIME=
ICS_TOKEN_SECRET=
# Необязательно: Web Push выключен без полного набора VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Необязательно: профиль compose tts; внутри сети http://tts:8000. Без URL — голос устройства.
TTS_URL=
# Публичный стенд: off скрывает демо-кнопки; пусто/нет переменной — on.
# Только app; переключение после пересоздания контейнера, без сборки.
DEMO_LOGIN_HINTS=
# Только migrate. Пусто — локальные пароли; на стенде задайте четыре своих.
# Формат: anna:<пароль>,timur:<пароль>,marina:<пароль>,oleg:<пароль>
# Каждый пароль от 12 символов, без пробелов, запятых и двоеточий.
# Публичные пароли по умолчанию в секрете запрещены.
DEMO_ACCOUNT_PASSWORDS=
# Расписания контейнеров используют Europe/Moscow.
TZ=
